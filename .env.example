# ═══════════════════════════════════════════════════════════════
# BotRemarketingIMOB — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com suas credenciais.

# --- Telegram Bot (Admin) ---
TELEGRAM_BOT_TOKEN=seu_token_aqui
ADMIN_TELEGRAM_ID=seu_id_aqui

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=https://sua-evolution.onrender.com
WHATSAPP_INSTANCE=nome_da_instancia
WHATSAPP_API_KEY=sua_api_key_aqui

# --- Supabase ---
# Acesse: https://supabase.com → Dashboard → Settings → API
# Use a "service_role" key (secret) para acesso backend completo.
SUPABASE_URL=https://gjjyyxgypglzsveiofjw.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui

# --- Motor de Disparos ---
DISPATCH_WINDOW_START=8
DISPATCH_WINDOW_END=20
DAILY_TARGET_MIN=15
DAILY_TARGET_MAX=40

# --- Painel Web ---
# Senha para acessar o painel admin web
WEB_PASSWORD=sua_senha_aqui
WEB_SECRET_KEY=chave-secreta-aleatoria-longa

# --- Render ---
PORT=8080
