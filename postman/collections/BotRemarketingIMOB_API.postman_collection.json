{
  "info": {
    "name": "BotRemarketingIMOB API",
    "description": "API REST completa do sistema de remarketing imobiliário via WhatsApp. Autenticação por sessão cookie. Rotas @instance_required exigem login por instância (/api/instance/login) antes de usar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔓 Público",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"]},
            "description": "Verifica se a API está online e respondendo."
          }
        },
        {
          "name": "Verificar Sessão Atual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/api/session", "host": ["{{base_url}}"], "path": ["api", "session"]},
            "description": "Retorna o estado da sessão atual. Resposta: {authenticated, instance, is_admin}."
          }
        },
        {
          "name": "Listar Instâncias Disponíveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/api/instances/available", "host": ["{{base_url}}"], "path": ["api", "instances", "available"]},
            "description": "Lista todas as instâncias disponíveis para login. Resposta: {instances: [{name, status, phone_formatted, display_name, has_access}]}."
          }
        },
        {
          "name": "Login por Instância",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instance\": \"{{instance_name}}\",\n  \"password\": \"{{instance_password}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/instance/login", "host": ["{{base_url}}"], "path": ["api", "instance", "login"]},
            "description": "Realiza login em uma instância específica pelo número/nome. Resposta: {ok, instance}. Necessário antes de usar rotas @instance_required."
          }
        }
      ]
    },
    {
      "name": "🔐 Autenticação",
      "item": [
        {
          "name": "Login Admin Global",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
